{
  "name": "fit-loop",
  "version": "0.7.0",
  "private": true,
  "description": "FitLoop · 训练 / 饮食 / 复盘一体化的移动端优先健身管理应用（本地优先，无后端可用）",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node tests/build.mjs && node --test tests/plan.test.mjs tests/nutrition.test.mjs tests/health.test.mjs tests/backup.test.mjs tests/version.test.mjs tests/nutrition-totals.test.mjs",
    "test:build": "node tests/build.mjs",
    "build:static": "node scripts/build-static.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "build:mp": "node scripts/build-mp.mjs",
    "set-mp-appid": "node scripts/set-mp-appid.mjs",
    "upload:mp": "node scripts/upload-mp.mjs",
    "build:apk": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/local-notifications": "^6.1.3",
    "idb": "^8.0.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/node": "^20.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
}
