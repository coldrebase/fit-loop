<view class="page">
  <view class="hd">
    <view class="hd-date">{{date}} 周{{weekday}}</view>
    <view class="hd-hi">你好，{{nickname}}</view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="ttl">今日训练</view>
      <view class="link" bindtap="goTrain">去训练 ›</view>
    </view>
    <view class="sub" wx:if="{{planMeta}}">{{planTitle}} · {{planMeta}}</view>
    <view class="sub" wx:else>{{planTitle}}</view>
    <view class="chip-warn" wx:if="{{inProgressTitle}}">有一节未结束的训练：{{inProgressTitle}}</view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="ttl">今日饮食</view>
      <view class="link" bindtap="goDiet">去记录 ›</view>
    </view>
    <view class="metrics">
      <view class="metric">
        <view class="m-val">{{totals.kcal}}<text class="m-unit">/{{targetKcal}}</text></view>
        <view class="m-label">热量 kcal</view>
      </view>
      <view class="metric">
        <view class="m-val">{{totals.protein}}<text class="m-unit">/{{targetProtein}}g</text></view>
        <view class="m-label">蛋白质</view>
      </view>
    </view>
    <view class="sub">碳水 {{totals.carb}}g · 脂肪 {{totals.fat}}g</view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="ttl">饮水</view>
      <view class="sub">{{waterMl}} / {{waterTarget}} ml</view>
    </view>
    <view class="row-btns">
      <button class="btn-mini" data-ml="200" bindtap="addWater">+200</button>
      <button class="btn-mini" data-ml="300" bindtap="addWater">+300</button>
      <button class="btn-mini" data-ml="500" bindtap="addWater">+500</button>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="ttl">体重</view>
      <view class="link" bindtap="recordWeight">记录 ›</view>
    </view>
    <view class="big-value">{{weight === null ? "—" : weight}}<text class="unit">kg</text></view>
  </view>

  <view class="section-title">最近训练</view>
  <view class="card" wx:if="{{recent.length === 0}}"><view class="sub">还没有训练记录。</view></view>
  <view class="card" wx:for="{{recent}}" wx:key="id">
    <view class="row-between">
      <view>{{item.title}}</view>
      <view class="sub">{{item.when}} · {{item.status}}</view>
    </view>
  </view>
</view>
