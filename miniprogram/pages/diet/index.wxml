<view class="page">
  <view class="card">
    <view class="row-between">
      <view class="ttl">{{date}}</view>
      <view class="sub">热量 {{pct.kcal}}% · 蛋白 {{pct.protein}}%</view>
    </view>
    <view class="metrics">
      <view class="metric">
        <view class="m-val">{{totals.kcal}}<text class="m-unit">/{{targets.kcal}}</text></view>
        <view class="m-label">热量 kcal</view>
      </view>
      <view class="metric">
        <view class="m-val">{{totals.protein}}<text class="m-unit">/{{targets.proteinG}}g</text></view>
        <view class="m-label">蛋白质</view>
      </view>
    </view>
    <view class="sub">碳水 {{totals.carb}}g · 脂肪 {{totals.fat}}g</view>
  </view>

  <view class="card" wx:for="{{slots}}" wx:key="value">
    <view class="row-between">
      <view class="ttl">{{item.label}}</view>
      <view class="link" data-slot="{{item.value}}" bindtap="openAdd">+ 添加</view>
    </view>
    <view wx:if="{{item.list.length === 0}}" class="sub">还没有记录。</view>
    <view class="entry" wx:for="{{item.list}}" wx:for-item="row" wx:key="id">
      <view class="entry-main">
        <view>{{row.name}}</view>
        <view class="sub">{{row.detail}}</view>
      </view>
      <view class="del" data-id="{{row.id}}" bindtap="del">删除</view>
    </view>
  </view>

  <!-- 添加弹层 -->
  <view class="mask" wx:if="{{adding}}" bindtap="closeAdd"></view>
  <view class="sheet" wx:if="{{adding}}">
    <view class="row-between">
      <view class="ttl">添加食物</view>
      <view class="link" bindtap="closeAdd">关闭</view>
    </view>

    <block wx:if="{{!picked}}">
      <input class="inp mt" placeholder="搜索内置食物，如：鸡胸" value="{{keyword}}" bindinput="onSearch" />
      <view class="result" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="pick">
        <view>{{item.name}}</view>
        <view class="sub">{{item.meta}}</view>
      </view>
      <view class="sub mt" wx:if="{{keyword && results.length === 0}}">没有匹配的内置食物。</view>
    </block>

    <block wx:else>
      <view class="ttl mt-s">{{picked.name}}</view>
      <view class="lbl">份量（克）</view>
      <input class="inp" type="number" value="{{grams}}" bindinput="onGrams" />
      <view class="lbl mt-s">归入哪一餐</view>
      <view class="chips">
        <view wx:for="{{slotOptions}}" wx:key="value" class="chip {{slot === item.value ? 'on' : ''}}" data-value="{{item.value}}" bindtap="setSlot">{{item.label}}</view>
      </view>
      <view class="card-tight mt" wx:if="{{preview}}">
        <view class="sub">本份 {{grams}}g</view>
        <view class="m-val">{{preview.kcal}}<text class="m-unit">kcal</text></view>
        <view class="sub">蛋白 {{preview.protein}}g · 碳水 {{preview.carb}}g · 脂肪 {{preview.fat}}g</view>
      </view>
      <button class="btn-primary mt" bindtap="addEntry">加入今天</button>
      <button class="btn-secondary mt" bindtap="closeAdd">返回</button>
    </block>
  </view>
</view>
